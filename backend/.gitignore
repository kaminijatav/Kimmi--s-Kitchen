*.tgz

# Optional npm cache directory
.npm

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS files
.DS_Store
Thumbs.db

# Debug
*.swp

# Build
dist/
build/

# Static file cache
.cache/
