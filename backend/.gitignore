# Node.js dependencies
node_modules/

# Environment variables
.env
.env.*        # in case you use multiple env files like .env.development

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

